model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Vendas","Calendário","Lojas","Produtos","Vendedores","Metas lojas","Metas vendedores","Metas lojas diária","Metas vendedores diária","Previsão","Parâmetros do diagnóstico","Parâmetros de cores","Referência da rede","Probabilidade da loja","Probabilidade da rede","Calibração da probabilidade","Parâmetros da probabilidade"]

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

ref table Vendas
ref table Calendário
ref table Lojas
ref table Produtos
ref table Vendedores
ref table Medidas
ref table 'Metas lojas'
ref table 'Metas vendedores'
ref table Setores
ref table 'Metas lojas diária'
ref table 'Metas vendedores diária'
ref table Previsão
ref table 'Eixo do mês'
ref table 'Modo do ranking'
ref table 'Parâmetros do diagnóstico'
ref table 'Parâmetros de cores'
ref table 'Referência da rede'
ref table 'Indicadores do diagnóstico'
ref table 'Itens de atenção'
ref table 'Itens fortes'
ref table 'Probabilidade da loja'
ref table 'Probabilidade da rede'
ref table 'Calibração da probabilidade'
ref table 'Parâmetros da probabilidade'

ref cultureInfo pt-BR

