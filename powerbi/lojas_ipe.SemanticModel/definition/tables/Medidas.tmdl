/// Tabela só para guardar as medidas DAX do relatório.
table Medidas
	lineageTag: 572f3939-6446-4d1b-a699-4deb218e46bf

	/// Receita líquida só das vendas concluídas (sem canceladas e devolvidas).
	measure Receita =
			CALCULATE(
			    SUM('Vendas'[receita_liquida]),
			    'Vendas'[status] = "Concluída"
			)
		formatString: "R$" #,0.00
		displayFolder: 1. Vendas
		lineageTag: 6e659f28-840e-4713-b395-9377d0540b53

	/// Custo das vendas concluídas.
	measure Custo = CALCULATE(SUM('Vendas'[custo]), 'Vendas'[status] = "Concluída")
		formatString: "R$" #,0.00
		displayFolder: 1. Vendas
		lineageTag: 59f9bf56-85a8-48af-b9fd-511aca50bce9

	/// Receita menos custo, só vendas concluídas.
	measure Margem = [Receita] - [Custo]
		formatString: "R$" #,0.00
		displayFolder: 1. Vendas
		lineageTag: ad96fec0-4bd3-4864-894e-129073c5abed

	/// Margem sobre a receita.
	measure 'Margem %' = DIVIDE([Margem], [Receita])
		formatString: 0.0%
		displayFolder: 1. Vendas
		lineageTag: 4af88f0a-3707-4607-a435-2a9b257c5e0f

	/// Unidades vendidas (concluídas).
	measure Quantidade = CALCULATE(SUM('Vendas'[quantidade]), 'Vendas'[status] = "Concluída")
		formatString: #,0
		displayFolder: 1. Vendas
		lineageTag: 986f7aa3-2fad-4398-99f0-bf2355939cf3

	/// Número de cupons concluídos.
	measure Cupons = CALCULATE(DISTINCTCOUNT('Vendas'[numero_cupom]), 'Vendas'[status] = "Concluída")
		formatString: #,0
		displayFolder: 1. Vendas
		lineageTag: 8afddbc3-7ee6-440a-8d66-3fa4ad73bb32

	/// Receita por cupom.
	measure 'Ticket médio' = DIVIDE([Receita], [Cupons])
		formatString: "R$" #,0.00
		displayFolder: 1. Vendas
		lineageTag: 8e880e5e-97bb-47ca-bb46-16f9dfe4d4f9

	/// Unidades por cupom.
	measure 'Itens por cupom' = DIVIDE([Quantidade], [Cupons])
		formatString: #,0.00
		displayFolder: 1. Vendas
		lineageTag: 5d0b3363-42f5-40ac-9c84-adae7dd7c236

	/// Desconto concedido nas vendas concluídas.
	measure Desconto = CALCULATE(SUM('Vendas'[desconto]), 'Vendas'[status] = "Concluída")
		formatString: "R$" #,0.00
		displayFolder: 1. Vendas
		lineageTag: 3fc03d8c-39e4-4b1b-8e02-ee96c0e9c561

	/// Cupons cancelados ÷ (concluídos + cancelados), mesma definição do relatório Excel.
	measure 'Taxa de cancelamento' =
			VAR canc = CALCULATE(DISTINCTCOUNT('Vendas'[numero_cupom]), 'Vendas'[status] = "Cancelada")
			RETURN DIVIDE(canc, canc + [Cupons])
		formatString: 0.0%
		displayFolder: 1. Vendas
		lineageTag: f511ff9e-5062-49f2-bf0b-cc96aeb5e5f1

	/// Acumulado do mês até a data do contexto (TOTALMTD).
	measure 'Receita acumulada no mês' = TOTALMTD([Receita], 'Calendário'[data])
		formatString: "R$" #,0.00
		displayFolder: 2. Tempo
		lineageTag: 9205c8d0-15e2-4210-ad83-fe619c03ce72

	/// Acumulado do ano até a data do contexto (TOTALYTD).
	measure 'Receita acumulada no ano' = TOTALYTD([Receita], 'Calendário'[data])
		formatString: "R$" #,0.00
		displayFolder: 2. Tempo
		lineageTag: ca983f2c-ae94-43a2-98e0-fbdfcb25f3b4

	/// Mesmo período do ano anterior (SAMEPERIODLASTYEAR).
	measure 'Receita ano anterior' = CALCULATE([Receita], SAMEPERIODLASTYEAR('Calendário'[data]))
		formatString: "R$" #,0.00
		displayFolder: 2. Tempo
		lineageTag: 5b48db98-7376-47f6-a24c-99732e12421f

	/// Variação da receita sobre o mesmo período do ano anterior.
	measure 'Evolução vs ano anterior' = DIVIDE([Receita] - [Receita ano anterior], [Receita ano anterior])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 2. Tempo
		lineageTag: 77474ae3-1500-4fdb-abce-3440fda6fee8

	/// Meta mensal da loja (por setor) para o(s) mês(es) do contexto, mesmo que só alguns dias estejam filtrados.
	measure 'Meta do mês' =
			CALCULATE(
			    SUM('Metas lojas'[valor_meta]),
			    REMOVEFILTERS('Calendário'),
			    TREATAS(VALUES('Calendário'[ano_mes_num]), 'Calendário'[ano_mes_num])
			)
		formatString: "R$" #,0.00
		displayFolder: 3. Metas
		lineageTag: 12b11e8d-042f-4431-ad0a-9b0941479fcc

	/// Receita ÷ meta do mês inteiro (sem cor de status no meio do mês).
	measure '% da meta do mês atingido' = DIVIDE([Receita], [Meta do mês])
		formatString: 0.0%
		displayFolder: 3. Metas
		lineageTag: 9926f1f5-4941-4b64-a234-2dbafb21d1bb

	/// Meta mensal do vendedor para o(s) mês(es) do contexto. Respeita a loja do contexto via TREATAS (Vendedores não tem relação com Lojas).
	measure 'Meta do mês (vendedor)' =
			CALCULATE(
			    SUM('Metas vendedores'[valor_meta]),
			    REMOVEFILTERS('Calendário'),
			    TREATAS(VALUES(Lojas[sk_loja]), Vendedores[sk_loja]),
			    TREATAS(VALUES('Calendário'[ano_mes_num]), 'Calendário'[ano_mes_num])
			)
		formatString: "R$" #,0.00
		displayFolder: 3. Metas
		lineageTag: 5334b447-0fb4-440b-b194-46f614897255

	/// Receita do vendedor ÷ meta do mês dele.
	measure '% da meta do mês atingido (vendedor)' = DIVIDE([Receita], [Meta do mês (vendedor)])
		formatString: 0.0%
		displayFolder: 3. Metas
		lineageTag: 6a2a6281-2185-408b-9d4f-e811436b1b12

	/// Soma das metas diárias dos dias filtrados (meta do dia num dia; meta acumulada até o dia num período do mês). Pesos de dia da semana e feriados vêm do dw.
	measure 'Meta do período' = SUM('Metas lojas diária'[valor_meta_dia])
		formatString: "R$" #,0.00
		displayFolder: 3. Metas
		lineageTag: ba5ac508-e167-4385-ae3d-67cbe47fb90f

	/// Meta diária acumulada do início do mês até a data do contexto (DATESMTD).
	measure 'Meta acumulada até o dia' = CALCULATE([Meta do período], DATESMTD('Calendário'[data]))
		formatString: "R$" #,0.00
		displayFolder: 3. Metas
		lineageTag: e7709d76-e15f-408d-8688-230e4894e72d

	/// Indicador principal no meio do mês: receita acumulada ÷ meta acumulada até o dia. Verde ≥ 100%.
	measure 'Cobertura da meta até o dia' = DIVIDE([Receita acumulada no mês], [Meta acumulada até o dia])
		formatString: 0.0%
		displayFolder: 3. Metas
		lineageTag: 982b3099-4c3f-46eb-8fef-3723489a942b

	/// Receita ÷ meta dos dias filtrados (ex.: cobertura do dia num gráfico diário).
	measure 'Cobertura do período' = DIVIDE([Receita], [Meta do período])
		formatString: 0.0%
		displayFolder: 3. Metas
		lineageTag: 2950909b-6601-4d6a-a52b-9345d60df251

	/// Soma das metas diárias do vendedor nos dias filtrados. Respeita a loja do contexto via TREATAS (Vendedores não tem relação com Lojas).
	measure 'Meta do período (vendedor)' = CALCULATE(SUM('Metas vendedores diária'[valor_meta_dia]), TREATAS(VALUES(Lojas[sk_loja]), Vendedores[sk_loja]))
		formatString: "R$" #,0.00
		displayFolder: 3. Metas
		lineageTag: 364be16f-b364-4e01-873c-877af1fe112b

	/// Meta diária do vendedor acumulada no mês até a data do contexto.
	measure 'Meta acumulada até o dia (vendedor)' = CALCULATE([Meta do período (vendedor)], DATESMTD('Calendário'[data]))
		formatString: "R$" #,0.00
		displayFolder: 3. Metas
		lineageTag: 7085e893-fb0e-4a18-99ec-1230a2858ee3

	/// Receita acumulada do vendedor ÷ meta acumulada dele até o dia.
	measure 'Cobertura da meta até o dia (vendedor)' = DIVIDE([Receita acumulada no mês], [Meta acumulada até o dia (vendedor)])
		formatString: 0.0%
		displayFolder: 3. Metas
		lineageTag: 93f71a4c-242e-4ea6-ac6b-d3ffae6aa747

	/// Verde se a cobertura da meta até o dia for ≥ 100%, vermelho se não. Usar em Formatação condicional → Valor do campo.
	measure 'Cor da cobertura' = IF(ISBLANK([Cobertura da meta até o dia]), BLANK(), IF([Cobertura da meta até o dia] >= 1, [Cor: verde], [Cor: vermelho]))
		displayFolder: 4. Formatação
		lineageTag: 03fb31e2-bd95-4ec2-95e3-052a63b76229

	/// Verde se a evolução vs ano anterior for positiva, vermelho se negativa.
	measure 'Cor da evolução' = IF(ISBLANK([Evolução vs ano anterior]), BLANK(), IF([Evolução vs ano anterior] >= 0, [Cor: verde], [Cor: vermelho]))
		displayFolder: 4. Formatação
		lineageTag: d3268c68-9374-4d85-9ad4-633d82ff0b1b

	/// Verde/vermelho para a cobertura do período (ex.: colunas do gráfico diário).
	measure 'Cor da cobertura do período' = IF(ISBLANK([Cobertura do período]), BLANK(), IF([Cobertura do período] >= 1, [Cor: verde], [Cor: vermelho]))
		displayFolder: 4. Formatação
		lineageTag: 84f83e3f-a687-4f41-a95d-60a1ffe0131b

	/// Diferença percentual da receita do dia para a meta do dia: (receita − meta) ÷ meta. Positivo = bateu a meta.
	measure 'Diferença para a meta do dia %' = DIVIDE([Receita] - [Meta do período], [Meta do período])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3. Metas
		lineageTag: 89bdfec0-620e-43bf-91ac-37dbf47a839e

	/// Verde se a diferença para a meta do dia é ≥ 0, vermelho se < 0 (barras divergentes).
	measure 'Cor da diferença' = IF(ISBLANK([Diferença para a meta do dia %]), BLANK(), IF([Diferença para a meta do dia %] >= 0, [Cor: verde], [Cor: vermelho]))
		displayFolder: 4. Formatação
		lineageTag: d5cf881e-495f-4f13-8fd5-4b8cd156d291

	/// Último dia com venda concluída no contexto de data (segmentação), ignorando loja, setor e vendedor. É a posição do relatório (no dw: dw.data_referencia() com o corte da segmentação).
	measure Posição =
			VAR ultimo =
			    CALCULATE(MAX('Vendas'[sk_tempo]), 'Vendas'[status] = "Concluída", REMOVEFILTERS(Lojas), REMOVEFILTERS(Produtos), REMOVEFILTERS(Setores), REMOVEFILTERS(Vendedores))
			RETURN
			    IF(NOT ISBLANK(ultimo), DATE(INT(ultimo / 10000), MOD(INT(ultimo / 100), 100), MOD(ultimo, 100)))
		formatString: dd/mm/yyyy
		displayFolder: 5. Projeção
		lineageTag: aba1efd7-33d7-4abe-a258-485226dd32a3

	/// Receita do início do mês da posição até a posição, ignorando o corte da segmentação no início do período.
	measure 'Receita realizada até a posição' =
			VAR pos = [Posição]
			VAR ini = DATE(YEAR(pos), MONTH(pos), 1)
			VAR fim = EOMONTH(pos, 0)
			RETURN
			    IF(NOT ISBLANK(pos), CALCULATE([Receita], REMOVEFILTERS('Calendário'), 'Calendário'[data] >= ini, 'Calendário'[data] <= pos))
		formatString: "R$" #,0.00
		displayFolder: 5. Projeção
		lineageTag: 9908c4d7-2866-4613-bb41-896e6559b304

	/// Meta mensal (loja x setor) do mês da posição, independente do corte da segmentação.
	measure 'Meta do mês da posição' =
			VAR pos = [Posição]
			RETURN
			    IF(
			        NOT ISBLANK(pos),
			        CALCULATE(SUM('Metas lojas'[valor_meta]), REMOVEFILTERS('Calendário'), 'Calendário'[ano_mes_num] = YEAR(pos) * 100 + MONTH(pos))
			    )
		formatString: "R$" #,0.00
		displayFolder: 5. Projeção
		lineageTag: 1d2b0517-d125-4843-a738-99b1af8c4df4

	/// Soma da previsão diária (dw.previsao_vendas, corte = posição) dos dias depois da posição até o fim do mês. Vazio quando não há previsão gerada para essa posição.
	measure 'Previsto restante do mês' =
			VAR pos = [Posição]
			VAR ini = DATE(YEAR(pos), MONTH(pos), 1)
			VAR fim = EOMONTH(pos, 0)
			RETURN
			    IF(
			        NOT ISBLANK(pos),
			        CALCULATE(
			            SUM('Previsão'[valor_previsto]),
			            REMOVEFILTERS('Calendário'),
			            'Previsão'[treino_ate] = pos,
			            'Previsão'[data] > pos,
			            'Previsão'[data] <= fim
			        )
			    )
		formatString: "R$" #,0.00
		displayFolder: 5. Projeção
		lineageTag: adec3c83-39d3-4fca-8074-bbec19972a3a

	/// Receita realizada até a posição + previsto dos dias restantes do mês (mesma conta de dw.fn_projecao_fechamento_mes). Vazio se faltar previsão para a posição.
	measure 'Projeção de fechamento' =
			VAR pos = [Posição]
			VAR ini = DATE(YEAR(pos), MONTH(pos), 1)
			VAR fim = EOMONTH(pos, 0)
			VAR real = [Receita realizada até a posição]
			VAR resto = [Previsto restante do mês]
			RETURN
			    IF(
			        ISBLANK(pos), BLANK(),
			        IF(pos >= fim, real, IF(ISBLANK(resto), BLANK(), real + resto))
			    )
		formatString: "R$" #,0.00
		displayFolder: 5. Projeção
		lineageTag: d212b501-1386-4589-af32-e8181ca5729c

	/// Projeção de fechamento ÷ meta do mês.
	measure 'Cobertura projetada' = DIVIDE([Projeção de fechamento], [Meta do mês da posição])
		formatString: 0.0%
		displayFolder: 5. Projeção
		lineageTag: 16edb5d4-03db-45b1-a1bc-f446b8c5d954

	/// O que falta da meta do mês ÷ dias restantes, contados em dias médios (meta dos dias restantes ÷ meta de um dia médio do mês), igual ao relatório Excel.
	measure 'Ritmo necessário por dia' =
			VAR pos = [Posição]
			VAR ini = DATE(YEAR(pos), MONTH(pos), 1)
			VAR fim = EOMONTH(pos, 0)
			VAR meta = [Meta do mês da posição]
			VAR falta = MAX(meta - [Receita realizada até a posição], 0)
			VAR metaRestante =
			    CALCULATE([Meta do período], REMOVEFILTERS('Calendário'), 'Calendário'[data] > pos, 'Calendário'[data] <= fim)
			VAR diasMedios = DIVIDE(metaRestante, DIVIDE(meta, DAY(fim)))
			RETURN
			    IF(NOT ISBLANK(pos), DIVIDE(falta, diasMedios))
		formatString: "R$" #,0.00
		displayFolder: 5. Projeção
		lineageTag: 7f40c619-dc28-47a8-9cb8-cd4cca02ad65

	/// Para o gráfico de acumulado (eixo 'Eixo do mês'[dia]): receita do início do mês até o dia do eixo, só até a posição.
	measure 'Receita acumulada (linha)' =
			VAR pos = [Posição]
			VAR ini = DATE(YEAR(pos), MONTH(pos), 1)
			VAR fim = EOMONTH(pos, 0)
			VAR d = MAX('Eixo do mês'[dia])
			RETURN
			    IF(
			        NOT ISBLANK(pos) && d >= ini && d <= pos,
			        CALCULATE([Receita], REMOVEFILTERS('Calendário'), 'Calendário'[data] >= ini, 'Calendário'[data] <= d)
			    )
		formatString: "R$" #,0.00
		displayFolder: 5. Projeção
		lineageTag: 8ebe2e44-d629-47c6-ab25-ad07bdd4597f

	/// Para o gráfico de acumulado: meta diária acumulada do início do mês até o dia do eixo, no mês inteiro.
	measure 'Meta acumulada (linha)' =
			VAR pos = [Posição]
			VAR ini = DATE(YEAR(pos), MONTH(pos), 1)
			VAR fim = EOMONTH(pos, 0)
			VAR d = MAX('Eixo do mês'[dia])
			RETURN
			    IF(
			        NOT ISBLANK(pos) && d >= ini && d <= fim,
			        CALCULATE([Meta do período], REMOVEFILTERS('Calendário'), 'Calendário'[data] >= ini, 'Calendário'[data] <= d)
			    )
		formatString: "R$" #,0.00
		displayFolder: 5. Projeção
		lineageTag: cda183dd-3eb4-4c90-9801-a9025d5d37da

	/// Para o gráfico de acumulado: realizado até a posição + previsto acumulado, só nos dias depois da posição.
	measure 'Projeção acumulada (linha)' =
			VAR pos = [Posição]
			VAR ini = DATE(YEAR(pos), MONTH(pos), 1)
			VAR fim = EOMONTH(pos, 0)
			VAR d = MAX('Eixo do mês'[dia])
			VAR previsto =
			    CALCULATE(
			        SUM('Previsão'[valor_previsto]),
			        REMOVEFILTERS('Calendário'),
			        'Previsão'[treino_ate] = pos,
			        'Previsão'[data] > pos,
			        'Previsão'[data] <= d
			    )
			RETURN
			    IF(NOT ISBLANK(pos) && d > pos && d <= fim && NOT ISBLANK(previsto), [Receita realizada até a posição] + previsto)
		formatString: "R$" #,0.00
		displayFolder: 5. Projeção
		lineageTag: 6a10d8a4-0884-414b-866b-b528f5df5148

	/// Linha de contexto do cartão de receita.
	measure 'Contexto da receita' = "Meta acumulada: R$ " & FORMAT([Meta acumulada até o dia], "#,0.00", "pt-BR")
		displayFolder: 6. Textos
		lineageTag: 7cc6d393-4762-4c82-ad77-ec1596a51ebd

	/// Linha de contexto do cartão de projeção.
	measure 'Contexto da projeção' = "Cobertura projetada: " & FORMAT([Cobertura projetada], "0.0%", "pt-BR")
		displayFolder: 6. Textos
		lineageTag: 4d725141-c303-4279-838e-653776bb63c1

	/// Linha de contexto do cartão de ritmo necessário (último dia do mês da posição).
	measure 'Contexto do ritmo' = "até " & FORMAT(EOMONTH([Posição], 0), "dd/mm", "pt-BR")
		displayFolder: 6. Textos
		lineageTag: e22c12d8-69dc-4f86-ab72-ee0dca08cc3c

	/// Para o tooltip do gráfico de acumulado: receita acumulada ÷ meta acumulada no dia do eixo.
	measure 'Cobertura acumulada (linha)' = DIVIDE([Receita acumulada (linha)], [Meta acumulada (linha)])
		formatString: 0.0%
		displayFolder: 5. Projeção
		lineageTag: b61289fe-c698-47c5-8af0-b3127d95566d

	/// Número de lojas com venda no período (contexto da segmentação).
	measure 'Lojas ativas' = COUNTROWS(FILTER(VALUES(Lojas[nome_loja]), NOT ISBLANK([Receita acumulada no mês])))
		formatString: 0
		displayFolder: 1. Vendas
		lineageTag: 9eb3fb96-9545-4fb3-8f55-997601c78c74

	/// Lojas com cobertura da meta até o dia ≥ 100%.
	measure 'Lojas acima da meta' = COUNTROWS(FILTER(VALUES(Lojas[nome_loja]), [Cobertura da meta até o dia] >= 1))
		formatString: 0
		displayFolder: 3. Metas
		lineageTag: f75b21eb-8c41-4bcf-81ad-1325eca2e4ff

	/// 1 = melhor cobertura da meta até o dia entre as lojas selecionadas. Só tem valor numa tabela/gráfico por loja.
	measure 'Posição da loja no ranking' = IF(ISINSCOPE(Lojas[nome_loja]), RANKX(ALLSELECTED(Lojas[nome_loja]), [Cobertura da meta até o dia], , DESC, DENSE))
		formatString: 0
		displayFolder: 3. Metas
		lineageTag: cf1d2f33-0e82-48c0-bb2f-a2b73059d12d

	/// Menor cobertura da meta até o dia entre as lojas com venda.
	measure 'Cobertura da pior loja' = MINX(FILTER(ALLSELECTED(Lojas[nome_loja]), NOT ISBLANK([Cobertura da meta até o dia])), [Cobertura da meta até o dia])
		formatString: 0.0%
		displayFolder: 3. Metas
		lineageTag: c712983a-0cc0-440d-9516-2bc1b6e086b2

	/// Verde/vermelho para a cobertura do vendedor.
	measure 'Cor da cobertura (vendedor)' = IF(ISBLANK([Cobertura da meta até o dia (vendedor)]), BLANK(), IF([Cobertura da meta até o dia (vendedor)] >= 1, [Cor: verde], [Cor: vermelho]))
		displayFolder: 4. Formatação
		lineageTag: 3dfef1c5-b58f-4f6a-9b69-e6ebdd181fb7

	/// Valor do cartão da página Lojas, ex.: 7 de 15.
	measure 'Lojas acima da meta (X de N)' = [Lojas acima da meta] & " de " & [Lojas ativas]
		displayFolder: 6. Textos
		lineageTag: 49091a99-45c7-400b-b95d-556d2034bc2f

	/// Frase completa, ex.: 7 de 15 lojas acima da meta.
	measure 'Texto das lojas acima da meta' = [Lojas acima da meta (X de N)] & " lojas acima da meta"
		displayFolder: 6. Textos
		lineageTag: 1ae5ffd5-aaa4-4c4b-95f8-7394641fb27f

	/// Nome da loja com a menor cobertura da meta até o dia.
	measure 'Pior loja' = MAXX(TOPN(1, FILTER(ALLSELECTED(Lojas[nome_loja]), NOT ISBLANK([Cobertura da meta até o dia])), [Cobertura da meta até o dia], ASC), Lojas[nome_loja])
		displayFolder: 6. Textos
		lineageTag: fc7596af-8afe-4883-a5c3-a7d2fe2d1426

	measure 'Contexto da pior loja' = "Cobertura: " & FORMAT([Cobertura da pior loja], "0.0%", "pt-BR")
		displayFolder: 6. Textos
		lineageTag: f44f7211-4be7-4211-a144-3d5aa4d7cadc

	/// Nome da loja da página Detalhe da loja (vem do drill-through).
	measure 'Nome da loja' = SELECTEDVALUE(Lojas[nome_loja], "Todas as lojas")
		displayFolder: 6. Textos
		lineageTag: efc460eb-8a87-4437-a4fd-13008b7f1461

	measure 'Contexto da loja' = IF(HASONEVALUE(Lojas[nome_loja]), SELECTEDVALUE(Lojas[cidade]) & " · " & SELECTEDVALUE(Lojas[uf]) & " · " & SELECTEDVALUE(Lojas[formato]), "Todas as lojas · escolha uma loja na lista")
		displayFolder: 6. Textos
		lineageTag: 5a9aed20-aa82-4834-9f83-07372561efae

	/// Para o gráfico de acumulado: meta final do mês da posição, igual em todos os dias do eixo (linha horizontal no topo). Respeita loja e setor.
	measure 'Meta do mês (linha)' =
			VAR pos = [Posição]
			VAR d = MAX('Eixo do mês'[dia])
			RETURN
			    IF(
			        NOT ISBLANK(pos) && d >= DATE(YEAR(pos), MONTH(pos), 1) && d <= EOMONTH(pos, 0),
			        [Meta do mês da posição]
			    )
		formatString: "R$" #,0.00
		displayFolder: 5. Projeção
		lineageTag: 3f8a6c21-5b7d-4e19-9a42-c1d0e7b85a36

	/// Para o tooltip: meta do mês − realizado até a posição (zero quando a meta já foi batida).
	measure 'Falta para a meta do mês' =
			VAR pos = [Posição]
			RETURN
			    IF(NOT ISBLANK(pos), MAX([Meta do mês da posição] - [Receita realizada até a posição], 0))
		formatString: """falta R$ ""#,0.00;;""meta batida"""
		displayFolder: 5. Projeção
		lineageTag: b94e2d70-1c6a-4f83-8d15-7a3e60c9f2b4

	/// Quanto falta (R$) para a meta acumulada até o dia; 0 quando já atingiu. Na rede é a diferença da rede, não a soma das lojas abaixo da meta.
	measure 'Falta para a meta até o dia' = MAX([Meta acumulada até o dia] - [Receita acumulada no mês], 0)
		formatString: "R$" #,0
		displayFolder: 3. Metas
		lineageTag: 6c1d8e47-2a93-4b05-8f6e-d41a7b09c352

	/// Parâmetro: quantas lojas o ranking mostra (10 piores / 10 melhores).
	measure 'Tamanho do ranking' = 10
		formatString: 0
		displayFolder: 3. Metas
		lineageTag: 91e5a3b8-7d20-4c64-a1f9-3e86b2d07c14

	/// Posição da loja pela cobertura da meta até o dia: 1 = pior no modo "10 piores" (crescente), 1 = melhor no modo "10 melhores" (decrescente). Sem seleção em 'Modo do ranking', vale "10 piores". Lojas sem cobertura ficam de fora.
	measure 'Posição no ranking (modo)' =
			VAR melhores = SELECTEDVALUE('Modo do ranking'[Ordem], 1) = 2
			VAR lojas = FILTER(ALLSELECTED(Lojas[nome_loja]), NOT ISBLANK([Cobertura da meta até o dia]))
			RETURN
			    IF(
			        ISINSCOPE(Lojas[nome_loja]) && NOT ISBLANK([Cobertura da meta até o dia]),
			        IF(
			            melhores,
			            RANKX(lojas, [Cobertura da meta até o dia], , DESC, DENSE),
			            RANKX(lojas, [Cobertura da meta até o dia], , ASC, DENSE)
			        )
			    )
		formatString: 0
		displayFolder: 3. Metas
		lineageTag: e2b74f10-8c35-4a96-b7d3-05f1a9c6e8d2

	/// 1 se a loja está entre as N do ranking no modo escolhido (filtro do visual do ranking).
	measure 'Mostrar no ranking' = IF(NOT ISBLANK([Posição no ranking (modo)]), IF([Posição no ranking (modo)] <= [Tamanho do ranking], 1, 0))
		formatString: 0
		displayFolder: 3. Metas
		lineageTag: 4a9f6d23-b1e8-4075-9c2a-68d3e7f10b95

	/// Vermelho forte se a cobertura da meta até o dia está abaixo de 80%; vermelho claro de 80% a 100%. Vazio quando não falta nada.
	measure 'Cor da falta' = IF([Falta para a meta até o dia] <= 0, BLANK(), IF([Cobertura da meta até o dia] < 0.8, [Cor: vermelho], [Cor: vermelho claro]))
		displayFolder: 4. Formatação
		lineageTag: 7d03c5e9-6f2a-4b18-a4d7-91e0b3a85c46

	/// Título do ranking de lojas, conforme o modo escolhido.
	measure 'Título do ranking' = "Lojas: as " & [Tamanho do ranking] & IF(SELECTEDVALUE('Modo do ranking'[Ordem], 1) = 2, " melhores", " piores") & " em cobertura"
		displayFolder: 6. Textos
		lineageTag: a8f14b60-3e97-4d52-8c0b-d25e6a7f9318

	/// Subtítulo do gráfico de acumulado: meta do mês e quanto falta.
	measure 'Subtítulo do acumulado' = "Meta do mês: R$ " & FORMAT([Meta do mês da posição], "#,0.00", "pt-BR") & IF([Falta para a meta do mês] > 0, "  ·  falta R$ " & FORMAT([Falta para a meta do mês], "#,0.00", "pt-BR"), "  ·  meta batida")
		displayFolder: 6. Textos
		lineageTag: 53c7e0a2-9d14-4f86-b3a1-e8749f2d6b07

	/// Subtítulo da faixa do Detalhe da loja: cidade · UF · formato da loja escolhida (ou "Todas as lojas") e a posição dos dados.
	measure 'Faixa da loja' = IF(HASONEVALUE(Lojas[nome_loja]), SELECTEDVALUE(Lojas[cidade]) & " · " & SELECTEDVALUE(Lojas[uf]) & " · " & SELECTEDVALUE(Lojas[formato]), "Todas as lojas") & " · posição em " & FORMAT([Posição], "dd/mm/yyyy", "pt-BR") & " · receita líquida de vendas concluídas"
		displayFolder: 6. Textos
		lineageTag: 8e24b1c7-0d93-4a5f-b6e8-17c9a3d5f204

	/// Evolução vs ano anterior como texto: "loja sem histórico" (ou "sem histórico") quando não há venda no mesmo período do ano anterior.
	measure 'Evolução vs ano anterior (texto)' = IF([Receita ano anterior] = 0, IF(HASONEVALUE(Lojas[nome_loja]), "loja sem histórico", "sem histórico"), FORMAT([Evolução vs ano anterior], "+0.0%;-0.0%;0.0%", "pt-BR"))
		displayFolder: 2. Tempo
		lineageTag: d7a35c18-4e92-4b60-9f1d-0a8b6e2c7f53

	/// 1 quando há exatamente uma loja no contexto (seletor da página); em branco caso contrário. Filtro da tabela de vendedores.
	measure 'Loja única escolhida' = IF(HASONEVALUE(Lojas[nome_loja]), 1)
		formatString: 0
		displayFolder: 6. Textos
		lineageTag: 5b7d2e19-4c60-4a83-9f15-d3e8a0c61b72

	/// Título da tabela de vendedores: sem loja escolhida, traz a orientação no próprio título (a tabela fica vazia).
	measure 'Título dos vendedores' = IF(HASONEVALUE(Lojas[nome_loja]), "Vendedores da loja", "Vendedores da loja · escolha uma loja para ver os vendedores")
		displayFolder: 6. Textos
		lineageTag: 9c41e6a8-2f75-4d0b-8a37-e1b5c7d90f43

	/// Preço × quantidade antes do desconto, de todos os status (concluídas, canceladas e devolvidas). Ponto de partida da cascata até a receita líquida.
	measure 'Receita bruta' = SUMX(Vendas, Vendas[preco_unitario] * Vendas[quantidade])
		formatString: "R$" #,0.00
		displayFolder: 1. Vendas
		lineageTag: 61f0a4fb-e617-4d91-bb72-dfdd4b4e8d98

	/// Preço × quantidade antes do desconto, só das vendas concluídas (base do desconto médio %).
	measure 'Receita bruta das concluídas' = CALCULATE(SUMX(Vendas, Vendas[preco_unitario] * Vendas[quantidade]), Vendas[status] = "Concluída")
		formatString: "R$" #,0.00
		displayFolder: 1. Vendas
		lineageTag: ce37048a-52f5-48ff-b70d-71a4d85f4175

	/// Valor bruto (preço × quantidade) das vendas canceladas.
	measure 'Cancelamentos (R$)' = CALCULATE(SUMX(Vendas, Vendas[preco_unitario] * Vendas[quantidade]), Vendas[status] = "Cancelada")
		formatString: "R$" #,0.00
		displayFolder: 1. Vendas
		lineageTag: d94490e2-7eec-464e-8cda-da8e493de616

	/// Valor bruto (preço × quantidade) das vendas devolvidas.
	measure 'Devoluções (R$)' = CALCULATE(SUMX(Vendas, Vendas[preco_unitario] * Vendas[quantidade]), Vendas[status] = "Devolvida")
		formatString: "R$" #,0.00
		displayFolder: 1. Vendas
		lineageTag: 217c25e9-7c67-4efa-a240-03d5f7a626f8

	/// Receita bruta − descontos − cancelamentos − devoluções − receita líquida. Deve ser 0,00 em qualquer contexto.
	measure 'Conferência da cascata' = ROUND([Receita bruta] - [Desconto] - [Cancelamentos (R$)] - [Devoluções (R$)] - [Receita], 2)
		formatString: "R$" #,0.00
		displayFolder: 1. Vendas
		lineageTag: f42bab87-732b-4af5-90ae-7ffd4e8aa01f

	/// Desconto das vendas concluídas ÷ receita bruta das concluídas.
	measure 'Desconto médio %' = DIVIDE([Desconto], [Receita bruta das concluídas])
		formatString: 0.0%
		displayFolder: 1. Vendas
		lineageTag: 5ac9785c-feeb-427b-8963-4c01907e9d38

	/// Vendedores com venda concluída no contexto (não é o cadastro).
	measure 'Vendedores ativos' = CALCULATE(DISTINCTCOUNT(Vendas[sk_vendedor]), Vendas[status] = "Concluída")
		formatString: #,0
		displayFolder: 1. Vendas
		lineageTag: 5a39fafa-cd64-495e-ba4a-5af6395c5857

	/// Receita líquida ÷ vendedores ativos.
	measure 'Venda por vendedor' = DIVIDE([Receita], [Vendedores ativos])
		formatString: "R$" #,0.00
		displayFolder: 1. Vendas
		lineageTag: 69770e34-015f-49fe-99b9-a87d8d45fa8b

	/// Receita do setor ÷ receita de todos os setores do contexto (respeita as segmentações).
	measure 'Participação do setor %' = DIVIDE([Receita], CALCULATE([Receita], ALLSELECTED(Setores)))
		formatString: 0.0%
		displayFolder: 1. Vendas
		lineageTag: c8c3ad39-44cf-465d-bb23-672a3190d222

	/// Receita da loja ÷ receita de todas as lojas do contexto (respeita as segmentações).
	measure 'Participação da loja %' = DIVIDE([Receita], CALCULATE([Receita], ALLSELECTED(Lojas)))
		formatString: 0.0%
		displayFolder: 1. Vendas
		lineageTag: 73515103-f600-41d1-aeb2-e67387e14f03

	/// Área de venda das lojas do contexto que tiveram receita no período.
	measure 'Área de venda (m²)' = SUMX(FILTER(Lojas, NOT ISBLANK([Receita])), Lojas[area_m2])
		formatString: #,0
		displayFolder: 1. Vendas
		lineageTag: 3e16d4aa-ae47-497f-8792-cb366a27e519

	/// Receita líquida ÷ área de venda (m²) das lojas com receita, no período do contexto.
	measure 'Venda por m²' = DIVIDE([Receita], [Área de venda (m²)])
		formatString: "R$" #,0.00
		displayFolder: 1. Vendas
		lineageTag: f6d7a27c-0580-40d1-9ad4-75246820e255

	/// Cupons concluídos do início do mês até a data do contexto.
	measure 'Cupons acumulados no mês' = CALCULATE([Cupons], DATESMTD('Calendário'[data]))
		formatString: #,0
		displayFolder: 2. Tempo
		lineageTag: 0675eaba-82ba-45ab-a1bc-10d002c76ce3

	/// Margem do início do mês até a data do contexto.
	measure 'Margem acumulada no mês' = CALCULATE([Margem], DATESMTD('Calendário'[data]))
		formatString: "R$" #,0.00
		displayFolder: 2. Tempo
		lineageTag: 274fb392-fe3f-436f-a1dd-353848d211f3

	/// Receita acumulada no mês anterior no mesmo intervalo de dias (1–15/12 contra 1–15/11).
	measure 'Receita mês anterior' = CALCULATE([Receita acumulada no mês], DATEADD('Calendário'[data], -1, MONTH))
		formatString: "R$" #,0.00
		displayFolder: 2. Tempo
		lineageTag: 208ec7cd-8f25-4372-acd4-66a1e8396daa

	/// Cupons acumulados no mês anterior no mesmo intervalo de dias.
	measure 'Cupons mês anterior' = CALCULATE([Cupons acumulados no mês], DATEADD('Calendário'[data], -1, MONTH))
		formatString: #,0
		displayFolder: 2. Tempo
		lineageTag: ee2a8701-c03e-4912-ac86-384ece16d1eb

	/// Margem acumulada no mês anterior no mesmo intervalo de dias.
	measure 'Margem mês anterior' = CALCULATE([Margem acumulada no mês], DATEADD('Calendário'[data], -1, MONTH))
		formatString: "R$" #,0.00
		displayFolder: 2. Tempo
		lineageTag: ab85088f-fa85-44be-90cc-744ae1f186c0

	/// Receita acumulada do mês ÷ receita do mês anterior (mesmo intervalo) − 1.
	measure 'Variação da receita vs mês anterior' = DIVIDE([Receita acumulada no mês] - [Receita mês anterior], [Receita mês anterior])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 2. Tempo
		lineageTag: d460955a-a3d8-4e79-860f-9b6b1280b235

	/// Cupons acumulados do mês ÷ cupons do mês anterior (mesmo intervalo) − 1.
	measure 'Variação dos cupons vs mês anterior' = DIVIDE([Cupons acumulados no mês] - [Cupons mês anterior], [Cupons mês anterior])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 2. Tempo
		lineageTag: 736b6ec1-4805-40fe-90b8-6219ee1cec81

	/// Margem acumulada do mês ÷ margem do mês anterior (mesmo intervalo) − 1.
	measure 'Variação da margem vs mês anterior' = DIVIDE([Margem acumulada no mês] - [Margem mês anterior], [Margem mês anterior])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 2. Tempo
		lineageTag: 2bb8da05-8ad3-4e16-a26c-fd4531b1000a

	/// Receita − receita do mesmo período do ano anterior; em branco quando a loja não tem histórico.
	measure 'Variação da receita vs ano anterior (R$)' = IF([Receita ano anterior] = 0, BLANK(), [Receita] - [Receita ano anterior])
		formatString: "R$" #,0.00;-"R$" #,0.00
		displayFolder: 2. Tempo
		lineageTag: 1aea4c8c-b87b-4c43-ac40-1716bfa3424e

	/// Margem do mesmo período do ano anterior.
	measure 'Margem ano anterior' = CALCULATE([Margem], SAMEPERIODLASTYEAR('Calendário'[data]))
		formatString: "R$" #,0.00
		displayFolder: 2. Tempo
		lineageTag: 7de16681-d251-4b7e-8e9d-b2295979d0fe

	/// Margem − margem do mesmo período do ano anterior; em branco sem histórico.
	measure 'Variação da margem vs ano anterior (R$)' = IF([Margem ano anterior] = 0, BLANK(), [Margem] - [Margem ano anterior])
		formatString: "R$" #,0.00;-"R$" #,0.00
		displayFolder: 2. Tempo
		lineageTag: e3bb96de-edf9-419e-b900-4ddf485f8f85

	/// Variação da margem em R$ ÷ margem do ano anterior; em branco sem histórico.
	measure 'Variação da margem vs ano anterior %' = DIVIDE([Variação da margem vs ano anterior (R$)], [Margem ano anterior])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 2. Tempo
		lineageTag: 9328a346-ec97-471d-ac17-112decf880bf

	/// Receita só das lojas comparáveis: abertas há mais de 12 meses antes da posição do relatório.
	measure 'Receita mesmas lojas' =
			VAR corte = EDATE([Posição], -12)
			RETURN
			    CALCULATE([Receita], Lojas[data_abertura] < corte)
		formatString: "R$" #,0.00
		displayFolder: 2. Tempo
		lineageTag: 5cc11a2c-8a8b-43a8-ad5c-d0faa4e40c60

	/// Receita do ano anterior das lojas comparáveis (abertas há mais de 12 meses antes da posição).
	measure 'Receita ano anterior mesmas lojas' =
			VAR corte = EDATE([Posição], -12)
			RETURN
			    CALCULATE([Receita ano anterior], Lojas[data_abertura] < corte)
		formatString: "R$" #,0.00
		displayFolder: 2. Tempo
		lineageTag: 703b3761-9eae-48b7-b4a1-f23c092652a2

	/// Evolução da receita vs ano anterior só nas lojas comparáveis (exclui as abertas há 12 meses ou menos).
	measure 'Evolução mesmas lojas' = DIVIDE([Receita mesmas lojas] - [Receita ano anterior mesmas lojas], [Receita ano anterior mesmas lojas])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 2. Tempo
		lineageTag: b97ec445-8e86-47dc-b0a3-5ff98f3b99ae

	/// Quantidade de lojas abertas há mais de 12 meses antes da posição, no contexto.
	measure 'Lojas comparáveis (qtde)' =
			VAR corte = EDATE([Posição], -12)
			RETURN
			    CALCULATE(DISTINCTCOUNT(Lojas[sk_loja]), Lojas[data_abertura] < corte)
		formatString: #,0
		displayFolder: 2. Tempo
		lineageTag: d18161a9-fe39-4ac2-bac1-e0d7858fc924

	/// Projeção de fechamento do mês ÷ área de venda (m²) das lojas com projeção. É o valor de um mês inteiro, comparável a referências de mercado (mensais); a 'Venda por m²' do período serve só para comparar lojas entre si.
	measure 'Venda por m² no mês (projetada)' = DIVIDE([Projeção de fechamento], SUMX(FILTER(Lojas, NOT ISBLANK([Projeção de fechamento])), Lojas[area_m2]))
		formatString: "R$" #,0.00
		displayFolder: 1. Vendas
		lineageTag: 84617b35-5ed1-47e6-9853-0e780fba8054

	/// Quadrante da loja: sinal da evolução da receita × sinal da variação da margem (R$) contra o mesmo período do ano anterior. Em branco para loja sem histórico.
	measure Quadrante =
			VAR x = [Evolução vs ano anterior]
			VAR y = [Variação da margem vs ano anterior %]
			RETURN
			    IF(
			        ISBLANK(x) || ISBLANK(y), BLANK(),
			        SWITCH(
			            TRUE(),
			            x >= 0 && y >= 0, "Cresce receita e margem",
			            x >= 0, "Cresce receita, perde margem",
			            y >= 0, "Perde receita, ganha margem",
			            "Perde receita e margem"
			        )
			    )
		displayFolder: 4. Formatação
		lineageTag: 2562adae-0a72-44da-8aa0-82ca17362153

	/// Cor fixa do quadrante: verde, laranja, azul ou vermelho.
	measure 'Cor do quadrante' =
			SWITCH(
			    [Quadrante],
			    "Cresce receita e margem", [Cor: verde],
			    "Cresce receita, perde margem", [Cor: laranja do quadrante],
			    "Perde receita, ganha margem", [Cor: azul do quadrante],
			    "Perde receita e margem", [Cor: vermelho],
			    BLANK()
			)
		displayFolder: 4. Formatação
		lineageTag: 18e220a4-252d-4015-aab8-5fdbfc14205e

	/// Soma, por loja, de MAX(0, meta até o dia − receita até o dia): só conta as lojas abaixo da meta (sem compensar com as que passaram). Respeita os filtros de data e de loja.
	measure 'Falta nas lojas abaixo da meta (até o dia)' = SUMX(VALUES(Lojas[nome_loja]), MAX([Meta acumulada até o dia] - [Receita acumulada no mês], 0))
		formatString: "R$" #,0
		displayFolder: 3. Metas
		lineageTag: 3b7e9d24-6a15-4c80-b2f7-8e41d0a95c63

	/// Vermelho se alguma loja está abaixo da meta (falta > 0); verde quando falta = 0.
	measure 'Cor da falta nas lojas' = IF(ISBLANK([Meta acumulada até o dia]), BLANK(), IF([Falta nas lojas abaixo da meta (até o dia)] > 0, [Cor: vermelho], [Cor: verde]))
		displayFolder: 4. Formatação
		lineageTag: c58a1f93-d207-4be6-9a34-70f2b6e8d1a5

	/// Subtítulo do gráfico de vendedores: a leitura da cor, ou a orientação quando não há uma loja só no contexto (o gráfico fica vazio).
	measure 'Subtítulo dos vendedores' = IF(HASONEVALUE(Lojas[nome_loja]), "acima de 100% = bateu a meta do dia", "escolha uma loja para ver os vendedores")
		displayFolder: 6. Textos
		lineageTag: 7fb6f830-4291-48e2-ad2c-0b3bd4b7030c

	/// Margem % da loja menos a margem % de todas as lojas do contexto, em pontos percentuais (+1,2 p.p. = 1,2 ponto acima da rede).
	measure 'Margem vs rede (p.p.)' = IF(NOT ISBLANK([Margem %]), ([Margem %] - [Margem % da rede]) * 100)
		formatString: +0.0\ \p\.\p\.;-0.0\ \p\.\p\.;0.0\ \p\.\p\.
		displayFolder: 1. Vendas
		lineageTag: 6cdf5117-37a8-4ae7-8d40-cffb408cec97

	/// Verde se a margem da loja estiver acima da rede, vermelho se abaixo.
	measure 'Cor da margem vs rede' = IF(ISBLANK([Margem vs rede (p.p.)]), BLANK(), IF([Margem vs rede (p.p.)] >= 0, [Cor: verde], [Cor: vermelho]))
		displayFolder: 4. Formatação
		lineageTag: 8f9025f9-8263-4534-84ff-bb953d3a197d

	/// Evolução da receita das lojas comparáveis (abertas há mais de 12 meses) em texto com sinal.
	measure 'Evolução mesmas lojas (texto)' = IF(ISBLANK([Evolução mesmas lojas]), "sem lojas comparáveis", FORMAT([Evolução mesmas lojas], "+0.0%;-0.0%;0.0%", "pt-BR"))
		displayFolder: 6. Textos
		lineageTag: 98c72015-0f0a-407c-93af-11535ac5272e

	/// Verde se a evolução das mesmas lojas for ≥ 0, vermelho se negativa.
	measure 'Cor da evolução mesmas lojas' = IF(ISBLANK([Evolução mesmas lojas]), BLANK(), IF([Evolução mesmas lojas] >= 0, [Cor: verde], [Cor: vermelho]))
		displayFolder: 4. Formatação
		lineageTag: 573d44cf-92d6-479f-ace8-73c22f7aa36b

	/// Margem da rede no período. Vem de Referência da rede (sem loja, por causa do RLS), não de ALLSELECTED(Lojas).
	measure 'Margem % da rede' = DIVIDE(SUM('Referência da rede'[receita]) - SUM('Referência da rede'[custo]), SUM('Referência da rede'[receita]))
		formatString: 0.0%
		displayFolder: 1. Vendas
		lineageTag: 8eb881e6-5ab3-4b98-a802-3e7f9c7ed913

	/// Parâmetro do banco (etl.parametros_negocio): queda de cupons vs ano anterior que vira atenção (e alta igual que vira ponto forte).
	measure 'Limite: queda de cupons' = LOOKUPVALUE('Parâmetros do diagnóstico'[valor], 'Parâmetros do diagnóstico'[chave], "diag_cupons_queda")
		formatString: 0.0%
		displayFolder: 7. Diagnóstico
		lineageTag: 36635d64-afc0-4835-979b-cdc97f8071a7

	/// Parâmetro do banco: ticket médio abaixo desta fração do ticket da rede é atenção.
	measure 'Limite: ticket mínimo' = LOOKUPVALUE('Parâmetros do diagnóstico'[valor], 'Parâmetros do diagnóstico'[chave], "diag_ticket_minimo")
		formatString: 0.0%
		displayFolder: 7. Diagnóstico
		lineageTag: bc1804a9-bc88-45d2-b358-78af626b8a44

	/// Parâmetro do banco: ticket médio acima desta fração do ticket da rede é ponto forte.
	measure 'Limite: ticket forte' = LOOKUPVALUE('Parâmetros do diagnóstico'[valor], 'Parâmetros do diagnóstico'[chave], "diag_ticket_forte")
		formatString: 0.0%
		displayFolder: 7. Diagnóstico
		lineageTag: 3ac2d8a0-ae55-4c82-852d-538d34d94617

	/// Parâmetro do banco: diferença de desconto médio para a rede (fração do bruto) que vira atenção ou ponto forte.
	measure 'Limite: desconto (p.p.)' = LOOKUPVALUE('Parâmetros do diagnóstico'[valor], 'Parâmetros do diagnóstico'[chave], "diag_desconto_pp")
		formatString: 0.0%
		displayFolder: 7. Diagnóstico
		lineageTag: 8d4358d0-4057-44ca-8e2e-2b943ff50a6d

	/// Parâmetro do banco: setor com cobertura da meta abaixo desta fração é fraco.
	measure 'Limite: setor fraco' = LOOKUPVALUE('Parâmetros do diagnóstico'[valor], 'Parâmetros do diagnóstico'[chave], "diag_setor_fraco")
		formatString: 0.0%
		displayFolder: 7. Diagnóstico
		lineageTag: c2b8e4ba-1914-4b66-aeb3-4fc14681c5c3

	/// Parâmetro do banco: setor com cobertura da meta a partir desta fração é forte.
	measure 'Limite: setor forte' = LOOKUPVALUE('Parâmetros do diagnóstico'[valor], 'Parâmetros do diagnóstico'[chave], "diag_setor_forte")
		formatString: 0.0%
		displayFolder: 7. Diagnóstico
		lineageTag: f75d890c-f59f-472c-9764-7d39729f98f4

	/// Parâmetro do banco: fração de vendedores abaixo da meta que vira atenção.
	measure 'Limite: equipe abaixo' = LOOKUPVALUE('Parâmetros do diagnóstico'[valor], 'Parâmetros do diagnóstico'[chave], "diag_equipe_abaixo")
		formatString: 0.0%
		displayFolder: 7. Diagnóstico
		lineageTag: e6bb8753-d561-49fe-ada9-df690f8e5c90

	/// Parâmetro do banco: fração de vendedores acima da meta que vira ponto forte.
	measure 'Limite: equipe acima' = LOOKUPVALUE('Parâmetros do diagnóstico'[valor], 'Parâmetros do diagnóstico'[chave], "diag_equipe_acima")
		formatString: 0.0%
		displayFolder: 7. Diagnóstico
		lineageTag: 9a519813-eb2d-4b1b-a0eb-3a9ec66ef7fa

	/// Parâmetro do banco: meta abaixo (folgada) ou acima (apertada) da venda do ano anterior por esta fração.
	measure 'Limite: meta folgada ou apertada' = LOOKUPVALUE('Parâmetros do diagnóstico'[valor], 'Parâmetros do diagnóstico'[chave], "diag_meta_folga")
		formatString: 0.0%
		displayFolder: 7. Diagnóstico
		lineageTag: fc22303d-28f2-4483-9a82-70c9ca225ffb

	/// 1 quando há exatamente uma loja no contexto; o diagnóstico só vale para uma loja.
	measure 'Uma loja escolhida' = IF(HASONEVALUE(Lojas[nome_loja]), 1, 0)
		formatString: 0
		displayFolder: 7. Diagnóstico
		lineageTag: c9d3c738-c407-4914-b5a1-4f67f34ac98e

	/// 1 se a loja abriu há menos de 12 meses antes da posição (ainda sem ano anterior).
	measure 'Loja em maturação' = IF([Uma loja escolhida] = 1 && MIN(Lojas[data_abertura]) > EDATE([Posição], -12), 1, 0)
		formatString: 0
		displayFolder: 7. Diagnóstico
		lineageTag: 34c8d213-1f70-4f43-9597-99ac8af436f9

	/// Cupons do mês até o dia, no mesmo período do ano anterior; em branco quando a loja não tinha vendas então (sem base).
	measure 'Cupons acumulados ano anterior' =
			VAR c = CALCULATE([Cupons acumulados no mês], SAMEPERIODLASTYEAR('Calendário'[data]))
			VAR r = CALCULATE([Receita acumulada no mês], SAMEPERIODLASTYEAR('Calendário'[data]))
			RETURN IF(r > 0, c)
		formatString: #,0
		displayFolder: 7. Diagnóstico
		lineageTag: 56c7e512-c7a5-4bf4-87b0-6a7a76b31bf4

	/// Cupons do mês até o dia ÷ mesmo período do ano anterior − 1. Em branco sem base.
	measure 'Cupons vs ano anterior %' =
			VAR ant = [Cupons acumulados ano anterior]
			RETURN IF(NOT ISBLANK(ant), DIVIDE([Cupons acumulados no mês], ant) - 1)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 7. Diagnóstico
		lineageTag: cac5dac2-a874-4b11-bc94-62a62a5d543e

	/// Receita do mês até o dia no mesmo período do ano anterior; em branco quando não houve venda.
	measure 'Receita acumulada ano anterior' =
			VAR r = CALCULATE([Receita acumulada no mês], SAMEPERIODLASTYEAR('Calendário'[data]))
			RETURN IF(r > 0, r)
		formatString: "R$" #,0.00
		displayFolder: 7. Diagnóstico
		lineageTag: e81f242d-8ca7-4810-918c-92ae9bc7b9cd

	/// Meta até o dia ÷ venda do mesmo período do ano anterior − 1: negativa = meta folgada, positiva = meta apertada.
	measure 'Meta vs venda do ano anterior %' =
			VAR ant = [Receita acumulada ano anterior]
			RETURN IF(NOT ISBLANK(ant), DIVIDE([Meta acumulada até o dia], ant) - 1)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 7. Diagnóstico
		lineageTag: 641db62f-732f-4950-896d-3b82c52a03b7

	/// Receita do mês até o dia ÷ cupons do mês até o dia.
	measure 'Ticket médio até o dia' = DIVIDE([Receita acumulada no mês], [Cupons acumulados no mês])
		formatString: "R$" #,0.00
		displayFolder: 7. Diagnóstico
		lineageTag: db85155a-5b28-45b8-9db9-961db183a8f9

	/// Ticket médio da rede no mês até o dia. Vem de Referência da rede (sem loja, por causa do RLS), não de ALL(Lojas).
	measure 'Ticket médio da rede até o dia' =
			DIVIDE(
			    CALCULATE(SUM('Referência da rede'[receita]), DATESMTD('Calendário'[data])),
			    CALCULATE(SUM('Referência da rede'[cupons]), DATESMTD('Calendário'[data]))
			)
		formatString: "R$" #,0.00
		displayFolder: 7. Diagnóstico
		lineageTag: 3cf08a06-8262-4597-a60d-d8cac02e9f7e

	/// Ticket médio da loja ÷ ticket médio da rede (1,10 = 10% acima).
	measure 'Ticket vs rede (razão)' = DIVIDE([Ticket médio até o dia], [Ticket médio da rede até o dia])
		formatString: 0.000
		displayFolder: 7. Diagnóstico
		lineageTag: 848205f2-b1c5-4501-9f91-1a64a1013e68

	/// Desconto ÷ valor bruto das concluídas, no mês até o dia.
	measure 'Desconto médio até o dia' =
			DIVIDE(
			    CALCULATE([Desconto], DATESMTD('Calendário'[data])),
			    CALCULATE([Receita bruta das concluídas], DATESMTD('Calendário'[data]))
			)
		formatString: 0.00%
		displayFolder: 7. Diagnóstico
		lineageTag: 1bcd6f83-a3fc-4194-8b69-ce63aa0ac647

	/// Desconto médio da rede no mês até o dia (Referência da rede, sem loja).
	measure 'Desconto médio da rede até o dia' =
			DIVIDE(
			    CALCULATE(SUM('Referência da rede'[desconto]), DATESMTD('Calendário'[data])),
			    CALCULATE(SUM('Referência da rede'[receita_bruta]), DATESMTD('Calendário'[data]))
			)
		formatString: 0.00%
		displayFolder: 7. Diagnóstico
		lineageTag: 23b69975-e8a5-459f-9ee6-59643f7b23d2

	/// Desconto médio da loja − desconto médio da rede (fração do bruto; 0,005 = 0,5 p.p.).
	measure 'Desconto vs rede (diferença)' = IF([Uma loja escolhida] = 1 && NOT ISBLANK([Desconto médio até o dia]), [Desconto médio até o dia] - [Desconto médio da rede até o dia])
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: 7. Diagnóstico
		lineageTag: d3d0c2cd-ac91-4dd9-b7fb-04ce0ad560bf

	/// Receita do mês até o dia ÷ meta até o dia, no setor do contexto. Em branco se não há meta.
	measure 'Cobertura do setor' =
			VAR meta = [Meta acumulada até o dia]
			RETURN IF(meta > 0, DIVIDE(COALESCE([Receita acumulada no mês], 0), meta))
		formatString: 0.0%
		displayFolder: 7. Diagnóstico
		lineageTag: ad43d955-7026-4a1a-b6c2-5615b22d118c

	/// Receita − meta do mês até o dia, no setor do contexto.
	measure 'Contribuição do setor (R$)' = COALESCE([Receita acumulada no mês], 0) - COALESCE([Meta acumulada até o dia], 0)
		formatString: "R$" #,0
		displayFolder: 7. Diagnóstico
		lineageTag: bb92b0db-9c4d-4c6a-9fb8-e6e7d268e7af

	/// Setores da loja com cobertura abaixo do limite de setor fraco.
	measure 'Setores fracos (qtde)' = COUNTROWS(FILTER(VALUES(Setores[setor]), VAR c = [Cobertura do setor] RETURN NOT ISBLANK(c) && c < [Limite: setor fraco])) + 0
		formatString: 0
		displayFolder: 7. Diagnóstico
		lineageTag: 0bace525-0221-4c8a-98bb-86bd78fb43f5

	/// Setores da loja com cobertura a partir do limite de setor forte.
	measure 'Setores fortes (qtde)' = COUNTROWS(FILTER(VALUES(Setores[setor]), VAR c = [Cobertura do setor] RETURN NOT ISBLANK(c) && c >= [Limite: setor forte])) + 0
		formatString: 0
		displayFolder: 7. Diagnóstico
		lineageTag: 12457df4-8abd-4da0-ab5f-c7e0bbc01388

	/// Setores fracos do mais fraco ao menos fraco, com a cobertura: "Eletro (60%), Limpeza (61%)".
	measure 'Setores fracos (lista)' =
			CONCATENATEX(
			    FILTER(ADDCOLUMNS(VALUES(Setores[setor]), "@cob", [Cobertura do setor]), NOT ISBLANK([@cob]) && [@cob] < [Limite: setor fraco]),
			    Setores[setor] & " (" & FORMAT([@cob], "0%", "pt-BR") & ")",
			    ", ",
			    [@cob], ASC
			)
		displayFolder: 7. Diagnóstico
		lineageTag: f90facef-f1a9-49dc-8291-196842f01782

	/// Setores fortes do mais forte ao menos forte, com a cobertura.
	measure 'Setores fortes (lista)' =
			CONCATENATEX(
			    FILTER(ADDCOLUMNS(VALUES(Setores[setor]), "@cob", [Cobertura do setor]), NOT ISBLANK([@cob]) && [@cob] >= [Limite: setor forte]),
			    Setores[setor] & " (" & FORMAT([@cob], "0%", "pt-BR") & ")",
			    ", ",
			    [@cob], DESC
			)
		displayFolder: 7. Diagnóstico
		lineageTag: f4078a20-b9d5-40aa-b327-ae4cb4d0c6e4

	/// Setor com a maior diferença positiva entre receita e meta no mês até o dia; "nenhum" se nenhum setor passou da meta.
	measure 'Setor que mais puxa' =
			VAR t = ADDCOLUMNS(VALUES(Setores[setor]), "@c", [Contribuição do setor (R$)])
			VAR maximo = MAXX(t, [@c])
			RETURN
			    IF(
			        [Uma loja escolhida] = 0, BLANK(),
			        IF(maximo > 0, MAXX(TOPN(1, t, [@c], DESC), Setores[setor]) & " (+R$ " & FORMAT(maximo, "#,0", "pt-BR") & ")", "nenhum")
			    )
		displayFolder: 7. Diagnóstico
		lineageTag: 7b28572f-b9ec-4947-a7bc-035842eeb926

	/// Setor com a maior diferença negativa entre receita e meta no mês até o dia; "nenhum" se nenhum setor ficou abaixo da meta.
	measure 'Setor que mais derruba' =
			VAR t = ADDCOLUMNS(VALUES(Setores[setor]), "@c", [Contribuição do setor (R$)])
			VAR minimo = MINX(t, [@c])
			RETURN
			    IF(
			        [Uma loja escolhida] = 0, BLANK(),
			        IF(minimo < 0, MAXX(TOPN(1, t, [@c], ASC), Setores[setor]) & " (-R$ " & FORMAT(-minimo, "#,0", "pt-BR") & ")", "nenhum")
			    )
		displayFolder: 7. Diagnóstico
		lineageTag: e6246202-6388-4bba-98a2-06a69ad68b3a

	/// Vendedores da loja com meta no mês até o dia.
	measure 'Vendedores com meta (qtde)' = COUNTROWS(FILTER(CALCULATETABLE(VALUES(Vendedores[cod_vendedor]), TREATAS(VALUES(Lojas[sk_loja]), Vendedores[sk_loja])), [Meta acumulada até o dia (vendedor)] > 0)) + 0
		formatString: 0
		displayFolder: 7. Diagnóstico
		lineageTag: b3c36f9a-fe16-4e13-adaf-54886f4f6686

	/// Vendedores da loja cuja receita no mês até o dia é menor que a meta deles (sem venda conta como abaixo).
	measure 'Vendedores abaixo da meta (qtde)' = COUNTROWS(FILTER(FILTER(CALCULATETABLE(VALUES(Vendedores[cod_vendedor]), TREATAS(VALUES(Lojas[sk_loja]), Vendedores[sk_loja])), [Meta acumulada até o dia (vendedor)] > 0), COALESCE([Receita acumulada no mês], 0) < [Meta acumulada até o dia (vendedor)])) + 0
		formatString: 0
		displayFolder: 7. Diagnóstico
		lineageTag: 44151b76-7dea-4c5d-a2bd-e4d34f8af622

	/// Vendedores abaixo da meta ÷ vendedores com meta.
	measure 'Vendedores abaixo da meta %' = DIVIDE([Vendedores abaixo da meta (qtde)], [Vendedores com meta (qtde)])
		formatString: 0%
		displayFolder: 7. Diagnóstico
		lineageTag: ba6f1157-81f5-422b-a540-18b0b37a7ba6

	/// Fluxo de cupons vs ano anterior. +1 ponto forte, -1 atenção, 0 neutro, em branco sem base.
	measure 'Sinal: fluxo' = IF([Uma loja escolhida] = 0, BLANK(), VAR v = [Cupons vs ano anterior %] RETURN IF(ISBLANK(v), BLANK(), IF(v <= -[Limite: queda de cupons], -1, IF(v >= [Limite: queda de cupons], 1, 0))))
		formatString: 0
		displayFolder: 7. Diagnóstico
		lineageTag: 6cf1b36c-f4a3-4a23-ad9b-a650bf380f9e

	/// Ticket médio vs rede. +1 ponto forte, -1 atenção, 0 neutro, em branco sem base.
	measure 'Sinal: ticket' = IF([Uma loja escolhida] = 0, BLANK(), VAR r = [Ticket vs rede (razão)] RETURN IF(ISBLANK(r), BLANK(), IF(r < [Limite: ticket mínimo], -1, IF(r >= [Limite: ticket forte], 1, 0))))
		formatString: 0
		displayFolder: 7. Diagnóstico
		lineageTag: 18a560dc-5837-45f0-8081-3d63aa96818b

	/// Desconto médio vs rede. +1 ponto forte, -1 atenção, 0 neutro, em branco sem base.
	measure 'Sinal: desconto' = IF([Uma loja escolhida] = 0, BLANK(), VAR d = [Desconto vs rede (diferença)] RETURN IF(ISBLANK(d), BLANK(), IF(d >= [Limite: desconto (p.p.)], -1, IF(d <= -[Limite: desconto (p.p.)], 1, 0))))
		formatString: 0
		displayFolder: 7. Diagnóstico
		lineageTag: f1275fb2-878d-43da-bc61-f5ca4416979f

	/// Setores fracos. +1 ponto forte, -1 atenção, 0 neutro, em branco sem base.
	measure 'Sinal: setor fraco' = IF([Uma loja escolhida] = 0, BLANK(), IF([Setores fracos (qtde)] > 0, -1, 0))
		formatString: 0
		displayFolder: 7. Diagnóstico
		lineageTag: 3c36da3a-7b5a-42bf-a981-a6c606b97e7b

	/// Setores fortes. +1 ponto forte, -1 atenção, 0 neutro, em branco sem base.
	measure 'Sinal: setor forte' = IF([Uma loja escolhida] = 0, BLANK(), IF([Setores fortes (qtde)] > 0, 1, 0))
		formatString: 0
		displayFolder: 7. Diagnóstico
		lineageTag: 61ebcacc-0315-42d7-9f5b-44dedbe39038

	/// Equipe. +1 ponto forte, -1 atenção, 0 neutro, em branco sem base.
	measure 'Sinal: equipe' = IF([Uma loja escolhida] = 0, BLANK(), VAR n = [Vendedores com meta (qtde)] VAR p = [Vendedores abaixo da meta %] RETURN IF(n = 0, BLANK(), IF(p >= [Limite: equipe abaixo], -1, IF(1 - p >= [Limite: equipe acima], 1, 0))))
		formatString: 0
		displayFolder: 7. Diagnóstico
		lineageTag: 7dd4f389-5cef-40ea-aaca-1d482d112a0e

	/// Meta vs venda do ano anterior (+1 folgada, -1 apertada). +1 ponto forte, -1 atenção, 0 neutro, em branco sem base.
	measure 'Sinal: meta' = IF([Uma loja escolhida] = 0, BLANK(), VAR v = [Meta vs venda do ano anterior %] RETURN IF(ISBLANK(v), BLANK(), IF(v <= -[Limite: meta folgada ou apertada], 1, IF(v >= [Limite: meta folgada ou apertada], -1, 0))))
		formatString: 0
		displayFolder: 7. Diagnóstico
		lineageTag: a853dafd-9d7a-4a49-8998-21edab36d255

	/// Frase do fluxo de cupons.
	measure 'Texto: fluxo' = VAR v = [Cupons vs ano anterior %] RETURN IF([Sinal: fluxo] < 0, "o fluxo de cupons caiu " & FORMAT(-v, "0.0%", "pt-BR"), IF([Sinal: fluxo] > 0, "o fluxo de cupons cresceu " & FORMAT(v, "0.0%", "pt-BR")))
		displayFolder: 7. Diagnóstico
		lineageTag: 48494df7-1fa8-453a-94de-db5b23e3811a

	/// Frase do ticket médio vs rede.
	measure 'Texto: ticket' = VAR r = [Ticket vs rede (razão)] RETURN IF([Sinal: ticket] < 0, "o ticket médio está " & FORMAT(1 - r, "0.0%", "pt-BR") & " abaixo da rede", IF([Sinal: ticket] > 0, "o ticket médio está " & FORMAT(r - 1, "0.0%", "pt-BR") & " acima da rede"))
		displayFolder: 7. Diagnóstico
		lineageTag: 98a9274d-7ff3-4569-91c7-d5655a0bff2b

	/// Frase do desconto médio vs rede.
	measure 'Texto: desconto' = VAR d = [Desconto vs rede (diferença)] RETURN IF([Sinal: desconto] < 0, "o desconto médio está " & FORMAT(d * 100, "0.0", "pt-BR") & " p.p. acima da rede", IF([Sinal: desconto] > 0, "o desconto médio está " & FORMAT(ABS(d) * 100, "0.0", "pt-BR") & " p.p. abaixo da rede"))
		displayFolder: 7. Diagnóstico
		lineageTag: fb38df0b-5eec-4d59-b5c9-a39b9abaade8

	/// Frase dos setores fracos.
	measure 'Texto: setor fraco' = IF([Sinal: setor fraco] < 0, [Setores fracos (lista)] & " abaixo de " & FORMAT([Limite: setor fraco], "0%", "pt-BR") & " da meta")
		displayFolder: 7. Diagnóstico
		lineageTag: 77f452ec-c65e-4acb-ae0d-fa66208dbee1

	/// Frase dos setores fortes.
	measure 'Texto: setor forte' = IF([Sinal: setor forte] > 0, [Setores fortes (lista)] & " acima de " & FORMAT([Limite: setor forte], "0%", "pt-BR") & " da meta")
		displayFolder: 7. Diagnóstico
		lineageTag: 7039db9d-572e-41a8-b88e-e0edb212a114

	/// Frase da equipe.
	measure 'Texto: equipe' = VAR n = [Vendedores com meta (qtde)] VAR b = [Vendedores abaixo da meta (qtde)] RETURN IF([Sinal: equipe] < 0, b & " de " & n & " vendedores abaixo da meta", IF([Sinal: equipe] > 0, (n - b) & " de " & n & " vendedores acima da meta"))
		displayFolder: 7. Diagnóstico
		lineageTag: 7fd9a134-ac76-49ec-94a3-4796cddbdc11

	/// Frase do contexto da meta.
	measure 'Texto: meta' = VAR v = [Meta vs venda do ano anterior %] RETURN IF([Sinal: meta] > 0, "meta " & FORMAT(-v, "0.0%", "pt-BR") & " abaixo da venda do ano anterior (folgada)", IF([Sinal: meta] < 0, "meta " & FORMAT(v, "0.0%", "pt-BR") & " acima da venda do ano anterior (apertada)"))
		displayFolder: 7. Diagnóstico
		lineageTag: 2e112656-4b57-4d38-8570-704307ba09a0

	/// Causas (sinal -1) em ordem de prioridade: setor fraco, equipe, fluxo, ticket, desconto. Só as 2 primeiras entram no veredito.
	measure 'Atenções (lista)' =
			VAR t = UNION(
					ROW("o", 1, "s", [Sinal: setor fraco], "t", [Texto: setor fraco]),
					ROW("o", 2, "s", [Sinal: equipe], "t", [Texto: equipe]),
					ROW("o", 3, "s", [Sinal: fluxo], "t", [Texto: fluxo]),
					ROW("o", 4, "s", [Sinal: ticket], "t", [Texto: ticket]),
					ROW("o", 5, "s", [Sinal: desconto], "t", [Texto: desconto])
				)
			RETURN CONCATENATEX(TOPN(2, FILTER(t, [s] = -1), [o], ASC), [t], "; ", [o], ASC)
		displayFolder: 7. Diagnóstico
		lineageTag: d300113a-4ae4-4795-ad7b-0c8a21a7d175

	/// Pontos fortes (sinal +1) em ordem de prioridade: setor forte, ticket, fluxo, equipe, desconto. Só os 2 primeiros entram no veredito.
	measure 'Pontos fortes (lista)' =
			VAR t = UNION(
					ROW("o", 1, "s", [Sinal: setor forte], "t", [Texto: setor forte]),
					ROW("o", 2, "s", [Sinal: ticket], "t", [Texto: ticket]),
					ROW("o", 3, "s", [Sinal: fluxo], "t", [Texto: fluxo]),
					ROW("o", 4, "s", [Sinal: equipe], "t", [Texto: equipe]),
					ROW("o", 5, "s", [Sinal: desconto], "t", [Texto: desconto])
				)
			RETURN CONCATENATEX(TOPN(2, FILTER(t, [s] = 1), [o], ASC), [t], "; ", [o], ASC)
		displayFolder: 7. Diagnóstico
		lineageTag: b56ceac6-ba12-4a5e-a4fc-611c50b00c41

	/// Quantidade de sinais de atenção.
	measure 'Atenções (qtde)' = COUNTROWS(FILTER(UNION(ROW("s", [Sinal: setor fraco]), ROW("s", [Sinal: equipe]), ROW("s", [Sinal: fluxo]), ROW("s", [Sinal: ticket]), ROW("s", [Sinal: desconto])), [s] = -1)) + 0
		formatString: 0
		displayFolder: 7. Diagnóstico
		lineageTag: fb9eddf0-d03b-4da4-837d-92fe59a1b77a

	/// Quantidade de pontos fortes (no máximo 2 entram no veredito).
	measure 'Pontos fortes (qtde)' = COUNTROWS(FILTER(UNION(ROW("s", [Sinal: setor forte]), ROW("s", [Sinal: ticket]), ROW("s", [Sinal: fluxo]), ROW("s", [Sinal: equipe]), ROW("s", [Sinal: desconto])), [s] = 1)) + 0
		formatString: 0
		displayFolder: 7. Diagnóstico
		lineageTag: edca6efa-5643-4af6-81b0-35a18a805ac7

	/// Texto do diagnóstico: situação, contexto de loja nova, até 2 causas, até 2 pontos fortes e o contexto da meta. Mesma regra de src/diagnostico.py.
	measure Veredito =
			VAR cob = [Cobertura da meta até o dia]
			VAR abertura = MIN(Lojas[data_abertura])
			VAR natenc = [Atenções (qtde)]
			VAR nforte = MIN([Pontos fortes (qtde)], 2)
			VAR p1 = IF(cob >= 1, "Acima", "Abaixo") & " da meta (" & FORMAT(cob, "0.0%", "pt-BR") & ")."
			VAR p2 = IF([Loja em maturação] = 1, " Loja em maturação: aberta em " & FORMAT(abertura, "dd/mm/yyyy", "pt-BR") & ", sem ano anterior; meta estimada com o histórico curto da loja e de lojas de formato semelhante.")
			VAR p3 = IF(natenc > 0, " Atenção: " & [Atenções (lista)] & ".", IF(cob < 1, " Sem causa clara nos indicadores (variação do período)."))
			VAR p4 = IF(nforte > 0, " " & IF(nforte = 1, "Ponto forte", "Pontos fortes") & ": " & [Pontos fortes (lista)] & ".")
			VAR p5 = IF(NOT ISBLANK([Sinal: meta]) && [Sinal: meta] <> 0, " Contexto: " & [Texto: meta] & ".")
			RETURN
			    IF(
			        [Uma loja escolhida] = 0, "Escolha uma loja para ver o diagnóstico.",
			        IF(ISBLANK(cob), "Sem meta no período.", p1 & p2 & p3 & p4 & p5)
			    )
		displayFolder: 7. Diagnóstico
		lineageTag: c7163f34-1b60-42fe-8ac0-88a6f5912989

	/// Para o cartão: variação de cupons ou "sem base".
	measure 'Fluxo de cupons vs ano anterior' = IF([Uma loja escolhida] = 0, BLANK(), IF(ISBLANK([Cupons vs ano anterior %]), "sem base", FORMAT([Cupons vs ano anterior %], "+0.0%;-0.0%;0.0%", "pt-BR")))
		displayFolder: 7. Diagnóstico
		lineageTag: 4b30ad1f-5b17-4990-82de-c545b6a68d7f

	/// Para o cartão: meta vs venda do ano anterior ou "sem base".
	measure 'Meta vs venda do ano anterior' = IF([Uma loja escolhida] = 0, BLANK(), IF(ISBLANK([Meta vs venda do ano anterior %]), "sem base", FORMAT([Meta vs venda do ano anterior %], "+0.0%;-0.0%;0.0%", "pt-BR")))
		displayFolder: 7. Diagnóstico
		lineageTag: c50f7b65-9c7b-490f-9e7d-ace3249ca9e8

	/// Verde (ponto forte), vermelho (atenção) ou cinza (neutro/sem base) para o cartão de fluxo de cupons.
	measure 'Cor do sinal: fluxo' = VAR s = [Sinal: fluxo] RETURN IF(ISBLANK(s), [Cor: cinza], IF(s > 0, [Cor: verde], IF(s < 0, [Cor: vermelho], [Cor: cinza do texto])))
		displayFolder: 4. Formatação
		lineageTag: ec240369-4b8e-42b8-b540-94cfd77adb79

	/// Valor da loja para o indicador da linha (tabela do diagnóstico).
	measure 'Indicador: loja' =
			IF([Uma loja escolhida] = 0, BLANK(), SWITCH(
			    SELECTEDVALUE('Indicadores do diagnóstico'[Ordem]),
			    1, IF(ISBLANK([Cupons vs ano anterior %]), "sem base", FORMAT([Cupons vs ano anterior %], "+0.0%;-0.0%;0.0%", "pt-BR") & " (" & COALESCE([Cupons acumulados no mês], 0) & " cupons)"),
			    2, FORMAT([Ticket médio até o dia], "R$ #,0.00", "pt-BR"),
			    3, FORMAT([Desconto médio até o dia], "0.00%", "pt-BR"),
			    4, [Setores fracos (qtde)] & " fraco(s) · " & [Setores fortes (qtde)] & " forte(s)",
			    5, [Vendedores abaixo da meta (qtde)] & " de " & [Vendedores com meta (qtde)] & " abaixo da meta",
			    6, FORMAT([Meta acumulada até o dia], "R$ #,0", "pt-BR") & IF(ISBLANK([Meta vs venda do ano anterior %]), " (sem base)", " (" & FORMAT([Meta vs venda do ano anterior %], "+0.0%;-0.0%;0.0%", "pt-BR") & ")"),
			    BLANK()
			))
		displayFolder: 7. Diagnóstico
		lineageTag: 91c81be9-36a9-48eb-b5fd-c242831bc42a

	/// Referência (rede ou ano anterior) do indicador da linha.
	measure 'Indicador: referência' =
			IF([Uma loja escolhida] = 0, BLANK(), SWITCH(
			    SELECTEDVALUE('Indicadores do diagnóstico'[Ordem]),
			    1, IF(ISBLANK([Cupons acumulados ano anterior]), "sem ano anterior", "ano anterior: " & [Cupons acumulados ano anterior]),
			    2, "rede: " & FORMAT([Ticket médio da rede até o dia], "R$ #,0.00", "pt-BR") & " (" & FORMAT([Ticket vs rede (razão)] - 1, "+0.0%;-0.0%;0.0%", "pt-BR") & ")",
			    3, "rede: " & FORMAT([Desconto médio da rede até o dia], "0.00%", "pt-BR") & " (" & FORMAT([Desconto vs rede (diferença)] * 100, "+0.00;-0.00;0.00", "pt-BR") & " p.p.)",
			    4, IF([Setores fracos (qtde)] > 0, "fracos: " & [Setores fracos (lista)], "nenhum setor fraco"),
			    5, FORMAT([Vendedores abaixo da meta %], "0%", "pt-BR") & " da equipe abaixo",
			    6, IF(ISBLANK([Receita acumulada ano anterior]), "sem ano anterior", "venda ano anterior: " & FORMAT([Receita acumulada ano anterior], "R$ #,0", "pt-BR")),
			    BLANK()
			))
		displayFolder: 7. Diagnóstico
		lineageTag: e8c558eb-4af6-499a-981c-185e32afc62f

	/// Limite (vindo do banco) do indicador da linha.
	measure 'Indicador: limite' =
			SWITCH(
			    SELECTEDVALUE('Indicadores do diagnóstico'[Ordem]),
			    1, "queda ≥ " & FORMAT([Limite: queda de cupons], "0%", "pt-BR"),
			    2, "< " & FORMAT([Limite: ticket mínimo], "0%", "pt-BR") & " da rede",
			    3, "≥ " & FORMAT([Limite: desconto (p.p.)] * 100, "0.0", "pt-BR") & " p.p. acima da rede",
			    4, "< " & FORMAT([Limite: setor fraco], "0%", "pt-BR") & " fraco · ≥ " & FORMAT([Limite: setor forte], "0%", "pt-BR") & " forte",
			    5, "≥ " & FORMAT([Limite: equipe abaixo], "0%", "pt-BR") & " abaixo",
			    6, "± " & FORMAT([Limite: meta folgada ou apertada], "0%", "pt-BR"),
			    BLANK()
			)
		displayFolder: 7. Diagnóstico
		lineageTag: b2c4d6b4-787f-485c-bf87-15f290694c5e

	/// Sinal (+1/-1/0) do indicador da linha; em branco sem base.
	measure 'Indicador: sinal' =
			SWITCH(
			    SELECTEDVALUE('Indicadores do diagnóstico'[Ordem]),
			    1, [Sinal: fluxo],
			    2, [Sinal: ticket],
			    3, [Sinal: desconto],
			    4, IF([Sinal: setor fraco] < 0, -1, [Sinal: setor forte]),
			    5, [Sinal: equipe],
			    6, [Sinal: meta],
			    BLANK()
			)
		formatString: 0
		displayFolder: 7. Diagnóstico
		lineageTag: a576cf6c-366d-4e04-b93c-7240e7590a28

	/// Atenção, Ponto forte, Neutro ou Sem base (na meta: Meta folgada, Meta apertada).
	measure 'Indicador: situação' =
			VAR s = [Indicador: sinal]
			VAR meta = SELECTEDVALUE('Indicadores do diagnóstico'[Ordem]) = 6
			RETURN
			    IF(
			        [Uma loja escolhida] = 0, BLANK(),
			        IF(ISBLANK(s), "Sem base", IF(meta, IF(s > 0, "Meta folgada", IF(s < 0, "Meta apertada", "Neutro")), IF(s > 0, "Ponto forte", IF(s < 0, "Atenção", "Neutro"))))
			    )
		displayFolder: 7. Diagnóstico
		lineageTag: 2eefd268-f330-4d8a-86bd-eac8150dd746

	/// Cor do texto da situação: verde (ponto forte), vermelho (atenção), cinza (sem base ou neutro).
	measure 'Cor da situação' = VAR s = [Indicador: sinal] VAR meta = SELECTEDVALUE('Indicadores do diagnóstico'[Ordem]) = 6 RETURN IF(ISBLANK(s), [Cor: cinza], IF(meta, IF(s = 0, [Cor: cinza], [Cor: âmbar]), IF(s > 0, [Cor: verde], IF(s < 0, [Cor: vermelho], [Cor: cinza]))))
		displayFolder: 4. Formatação
		lineageTag: 92524b71-6d4c-4fa3-b4db-cb729503c6ec

	/// Título do painel com a loja escolhida.
	measure 'Título do diagnóstico' = IF([Uma loja escolhida] = 1, "Diagnóstico · " & SELECTEDVALUE(Lojas[nome_loja]), "Diagnóstico da loja · escolha uma loja")
		displayFolder: 7. Diagnóstico
		lineageTag: e6a0ca8c-bc3b-44a7-a189-19abb18996c3

	/// Um item de atenção por linha da tabela 'Itens de atenção' (linhas sem item ficam em branco e a tabela as oculta).
	measure 'Item de atenção' =
			IF(
			    [Uma loja escolhida] = 0, IF(SELECTEDVALUE('Itens de atenção'[Ordem]) = 1, "Escolha uma loja."),
			    IF(
			        [Atenções (qtde)] = 0, IF(SELECTEDVALUE('Itens de atenção'[Ordem]) = 1, "Nenhum ponto de atenção."),
			        SWITCH(
			            SELECTEDVALUE('Itens de atenção'[Ordem]),
			        1, IF([Sinal: setor fraco] < 0, "• " & [Texto: setor fraco]),
			        2, IF([Sinal: equipe] < 0, "• " & [Texto: equipe]),
			        3, IF([Sinal: fluxo] < 0, "• " & [Texto: fluxo]),
			        4, IF([Sinal: ticket] < 0, "• " & [Texto: ticket]),
			        5, IF([Sinal: desconto] < 0, "• " & [Texto: desconto]),
			            BLANK()
			        )
			    )
			)
		displayFolder: 7. Diagnóstico
		lineageTag: 77b4e759-04c7-4eb6-b48a-37855be2d030

	/// Um ponto forte por linha da tabela 'Itens fortes' (linhas sem item ficam em branco e a tabela as oculta).
	measure 'Item forte' =
			IF(
			    [Uma loja escolhida] = 0, IF(SELECTEDVALUE('Itens fortes'[Ordem]) = 1, "Escolha uma loja."),
			    IF(
			        [Pontos fortes (qtde)] = 0, IF(SELECTEDVALUE('Itens fortes'[Ordem]) = 1, "Nenhum ponto forte."),
			        SWITCH(
			            SELECTEDVALUE('Itens fortes'[Ordem]),
			        1, IF([Sinal: setor forte] > 0, "• " & [Texto: setor forte]),
			        2, IF([Sinal: ticket] > 0, "• " & [Texto: ticket]),
			        3, IF([Sinal: fluxo] > 0, "• " & [Texto: fluxo]),
			        4, IF([Sinal: equipe] > 0, "• " & [Texto: equipe]),
			        5, IF([Sinal: desconto] > 0, "• " & [Texto: desconto]),
			            BLANK()
			        )
			    )
			)
		displayFolder: 7. Diagnóstico
		lineageTag: 37fd41cb-d3cf-4506-99de-2a5a1c91f3c4

	/// Cor do tema da lista: branco quando não há item (só a mensagem aparece, sem tema).
	measure 'Cor do tema (atenção)' = IF([Uma loja escolhida] = 1 && [Atenções (qtde)] > 0, "#242424", "#FFFFFF")
		displayFolder: 4. Formatação
		lineageTag: 8436a83c-4869-4e56-945d-fbe8369fb2e9

	/// Cor do tema da lista: branco quando não há item (só a mensagem aparece, sem tema).
	measure 'Cor do tema (forte)' = IF([Uma loja escolhida] = 1 && [Pontos fortes (qtde)] > 0, "#242424", "#FFFFFF")
		displayFolder: 4. Formatação
		lineageTag: 119469b4-6d55-4d75-9a6d-38aee603bef3

	column _
		isHidden
		lineageTag: c8c9ba0c-0854-4eb6-b153-4a6132a05ff3
		isNameInferred
		sourceColumn: [_]

	partition Medidas = calculated
		mode: import
		source = ROW("_", BLANK())

	/// Cabeçalho das páginas de loja (Detalhe e Diagnóstico): nome da loja do filtro de detalhamento.
	measure 'Loja escolhida (cabeçalho)' = IF(HASONEVALUE(Lojas[nome_loja]), "Loja: " & SELECTEDVALUE(Lojas[nome_loja]), "Escolha uma loja: botão direito numa loja na página Lojas")
		displayFolder: 6. Textos
		lineageTag: 1aa01d3b-dd6e-41ff-82d9-520f1c0f4f81

	/// Cor do banco (Parâmetros de cores, chave verde): meta batida, evolução positiva, ponto forte. As medidas de cor leem daqui; nada de #RRGGBB no DAX.
	measure 'Cor: verde' = LOOKUPVALUE('Parâmetros de cores'[cor], 'Parâmetros de cores'[chave], "verde")
		displayFolder: 4. Formatação
		lineageTag: bf60b187-61ae-4ba9-8f01-bc5b9ca7368a

	/// Cor do banco (Parâmetros de cores, chave vermelho): abaixo da meta, queda, atenção. As medidas de cor leem daqui; nada de #RRGGBB no DAX.
	measure 'Cor: vermelho' = LOOKUPVALUE('Parâmetros de cores'[cor], 'Parâmetros de cores'[chave], "vermelho")
		displayFolder: 4. Formatação
		lineageTag: 29a8fa7f-03a5-4df3-9e3e-ce0bad3e6608

	/// Cor do banco (Parâmetros de cores, chave vermelho_claro): falta para a meta entre 80% e 100% de cobertura. As medidas de cor leem daqui; nada de #RRGGBB no DAX.
	measure 'Cor: vermelho claro' = LOOKUPVALUE('Parâmetros de cores'[cor], 'Parâmetros de cores'[chave], "vermelho_claro")
		displayFolder: 4. Formatação
		lineageTag: f1b2e658-b0f7-4b33-bb70-275452e9c4d0

	/// Cor do banco (Parâmetros de cores, chave ambar): contexto ou alerta intermediário (nem mérito nem falha). As medidas de cor leem daqui; nada de #RRGGBB no DAX.
	measure 'Cor: âmbar' = LOOKUPVALUE('Parâmetros de cores'[cor], 'Parâmetros de cores'[chave], "ambar")
		displayFolder: 4. Formatação
		lineageTag: d11d998b-ffd5-4d4d-ad6e-ce21ec27e01b

	/// Cor do banco (Parâmetros de cores, chave laranja_quadrante): quadrante: cresce receita e perde margem. As medidas de cor leem daqui; nada de #RRGGBB no DAX.
	measure 'Cor: laranja do quadrante' = LOOKUPVALUE('Parâmetros de cores'[cor], 'Parâmetros de cores'[chave], "laranja_quadrante")
		displayFolder: 4. Formatação
		lineageTag: 6565d725-92da-4f72-abe2-b9f40554665b

	/// Cor do banco (Parâmetros de cores, chave azul_quadrante): quadrante: perde receita e ganha margem. As medidas de cor leem daqui; nada de #RRGGBB no DAX.
	measure 'Cor: azul do quadrante' = LOOKUPVALUE('Parâmetros de cores'[cor], 'Parâmetros de cores'[chave], "azul_quadrante")
		displayFolder: 4. Formatação
		lineageTag: ec038dcf-d3c5-48d0-ac1e-015e456e871e

	/// Cor do banco (Parâmetros de cores, chave cinza): neutro ou sem base. As medidas de cor leem daqui; nada de #RRGGBB no DAX.
	measure 'Cor: cinza' = LOOKUPVALUE('Parâmetros de cores'[cor], 'Parâmetros de cores'[chave], "cinza")
		displayFolder: 4. Formatação
		lineageTag: eb82b481-5214-4806-95e5-c0c91c4a51e8

	/// Cor do banco (Parâmetros de cores, chave cinza_texto): neutro em texto. As medidas de cor leem daqui; nada de #RRGGBB no DAX.
	measure 'Cor: cinza do texto' = LOOKUPVALUE('Parâmetros de cores'[cor], 'Parâmetros de cores'[chave], "cinza_texto")
		displayFolder: 4. Formatação
		lineageTag: c5e98aab-623f-4627-be29-4bece9bbde73

	/// Só para o eixo X do gráfico de quadrantes: mesmo valor de Evolução vs ano anterior, em 0.0% para o eixo mostrar o sinal de menos. Também é o valor que o tooltip mostra (as originais saíram do bucket Tooltips).
	measure 'Evolução vs ano anterior (eixo)' = [Evolução vs ano anterior]
		formatString: 0.0%
		isHidden
		displayFolder: 2. Tempo
		lineageTag: 1a5e4d2b-acc9-490a-93f6-d56466927ad8

	/// Só para o eixo Y do gráfico de quadrantes: mesmo valor de Variação da margem vs ano anterior %, em 0.0% para o eixo mostrar o sinal de menos. Também é o valor que o tooltip mostra (as originais saíram do bucket Tooltips).
	measure 'Variação da margem % (eixo)' = [Variação da margem vs ano anterior %]
		formatString: 0.0%
		isHidden
		displayFolder: 2. Tempo
		lineageTag: ae7760ba-2689-46c4-8024-cdf3149d1312
