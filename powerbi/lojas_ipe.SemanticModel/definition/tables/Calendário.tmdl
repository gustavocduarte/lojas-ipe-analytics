		sourceColumn: nome_feriado

		annotation SummarizationSetBy = Automatic

	/// 1 = segunda ... 7 = domingo (para ordenar o nome do dia).
	column num_dia_semana = WEEKDAY('Calendário'[data], 2)
		dataType: int64
		isHidden
		lineageTag: b49037e0-d23d-4a30-bc62-ab8f2cbf628f
		summarizeBy: none

	/// AAAAMM, para ordenar o rótulo Mês/ano.
	column ano_mes_num = 'Calendário'[ano] * 100 + 'Calendário'[mes]
		dataType: int64
		isHidden
		lineageTag: b00c8fe6-aacf-4020-9890-ccf54276c273
		summarizeBy: none

	/// Rótulo curto do mês, ex.: dez/25.
	column Mês/ano = FORMAT('Calendário'[data], "mmm/yy", "pt-BR")
		dataType: string
		lineageTag: 169b4c32-2888-4453-81b1-8ce8cefc8fd6
		summarizeBy: none
		sortByColumn: ano_mes_num

	partition 'dw dim_tempo' = m
		mode: import
		source =
				let
				    Fonte = PostgreSQL.Database("localhost", "lojas_ipe_dw"),
				    dw_dim_tempo = Fonte{[Schema="dw",Item="dim_tempo"]}[Data]
				in
				    dw_dim_tempo

	annotation PBI_ResultType = Table

