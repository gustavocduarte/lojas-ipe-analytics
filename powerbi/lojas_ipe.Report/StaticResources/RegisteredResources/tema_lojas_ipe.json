{
  "name": "Lojas Ipê",
  "dataColors": [
    "#2F6DB5",
    "#C55A11",
    "#9AA5B1",
    "#1F3A5F",
    "#6FA8DC",
    "#E69F6B",
    "#5B6B7C",
    "#3C8D93"
  ],
  "background": "#FFFFFF",
  "foreground": "#242424",
  "tableAccent": "#1F3A5F",
  "good": "#2E7D32",
  "bad": "#C62828",
  "neutral": "#C55A11",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#242424"
    },
    "title": {
      "fontSize": 14,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F3A5F"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#242424"
    },
    "label": {
      "fontSize": 12,
      "fontFace": "Segoe UI",
      "color": "#242424"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F5F8"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F3F5F8"
              }
            }
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3E7ED"
              }
            },
            "radius": 8,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 14,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#1F3A5F"
              }
            },
            "titleWrap": true
          }
        ],
        "subTitle": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "fontSize": 12,
            "fontFamily": "Segoe UI"
          }
        ],
        "valueAxis": [
          {
            "fontSize": 12,
            "fontFamily": "Segoe UI",
            "gridlineColor": {
              "solid": {
                "color": "#E3E7ED"
              }
            }
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "borderCustom": [
          {
            "$id": "default",
            "show": true,
            "borderWeight": 1,
            "borderColor": "#E3E7ED"
          }
        ],
        "subTitle": [
          {
            "show": true,
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#5B6B7C"
              }
            }
          }
        ]
      }
    },
    "lineClusteredColumnComboChart": {
      "*": {
        "lineStyles": [
          {
            "lineChartType": "linear"
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "lineChartType": "linear"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#1F3A5F"
              }
            }
          }
        ],
        "values": [
          {
            "fontSize": 12,
            "fontFamily": "Segoe UI"
          }
        ],
        "total": [
          {
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    }
  }
}